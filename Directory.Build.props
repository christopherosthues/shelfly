<Project>
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- CA1416 - Platform warning that all targeted platforms runs this code (which is exactly what I want, you idiot!) -->
        <NoWarn>$(NoWarn);CA1416</NoWarn>
        <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
        <Verify_SponsorshipExemptionUntil>2027-09</Verify_SponsorshipExemptionUntil>
    </PropertyGroup>

    <!-- Opt-in to new dotnet test experience for .NET 10+ -->
    <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
        <UseMicrosoftTestingPlatform>true</UseMicrosoftTestingPlatform>
    </PropertyGroup>
</Project>