<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Name="This"
             x:Class="Shelfly.App.Controls.ValidatingEntry">
    <VerticalStackLayout
        Spacing="8">

        <Entry
            x:Name="Entry"
            MaxLength="{Binding MaxLength, Mode=TwoWay, Source={x:Reference Name=This}}"
            Placeholder="{Binding Placeholder, Mode=TwoWay, Source={x:Reference Name=This}}"
            Text="{Binding Text, Mode=TwoWay, Source={x:Reference Name=This}}" />

        <Label
            x:Name="ErrorLabel"
            FontSize="12"
            IsVisible="{Binding IsValid, Converter={toolkit:InvertedBoolConverter}, Source={x:Reference Name=This}}"
            Text="{Binding ErrorText, Mode=TwoWay, Source={x:Reference Name=This}}"
            TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
    </VerticalStackLayout>
</ContentView>
