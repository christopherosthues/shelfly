<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Shelfly.App.Controls.BookCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:entities="clr-namespace:Shelfly.App.Data.Entities;assembly=Shelfly.App.Data"
    x:DataType="entities:BookEntity"
    Margin="16, 0"
    MinimumHeightRequest="48">

    <Border
        Style="{StaticResource CardBorder}"
        Padding="12">

        <Border.Shadow>
            <Shadow
                Brush="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                Opacity="0.3"
                Radius="8"
                Offset="2, 2" />
        </Border.Shadow>

        <Grid
            RowDefinitions="Auto, Auto, Auto">

            <Label
                Grid.Row="0"
                FontAttributes="Bold"
                Text="{Binding Title}" />

            <Label
                Grid.Row="1"
                Text="{Binding Author}" />

            <Label
                Grid.Row="2"
                Opacity="0.6"
                Text="{Binding Publisher}" />
        </Grid>
    </Border>
</ContentView>
