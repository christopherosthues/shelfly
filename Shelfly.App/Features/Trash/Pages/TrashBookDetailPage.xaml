<?xml version="1.0" encoding="utf-8"?>

<pages:ShelflyContentPageBase
    x:Class="Shelfly.App.Features.Trash.Pages.TrashBookDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="using:Shelfly.App.Resources.Localization"
    xmlns:viewModels="clr-namespace:Shelfly.App.Features.Trash.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:pages="clr-namespace:Shelfly.App.Pages"
    xmlns:entities="clr-namespace:Shelfly.App.Data.Entities;assembly=Shelfly.App.Data"
    x:DataType="viewModels:TrashBookDetailViewModel"
    Title="{x:Static local:AppResources.TrashBookDetailPageTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageSoftDeleteBookDescription}"
            Text="{x:Static local:AppResources.TrashListPageRestoreAllButtonText}"
            IconImageSource="restore_icon.svg"
            Command="{Binding RestoreBookCommand}" />

        <ToolbarItem
            SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageSoftDeleteBookDescription}"
            Text="{x:Static local:AppResources.TrashListPageDeleteAllButtonText}"
            IconImageSource="delete_icon.svg"
            Command="{Binding HardDeleteBookCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*" ColumnDefinitions="*">
        <!-- Book Details -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16" Padding="16">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HeightRequest="40"
                                   WidthRequest="40" />

                <VerticalStackLayout IsVisible="{Binding Book, Converter={toolkit:IsNotNullConverter}}"
                                     Spacing="8">
                    <!-- Title (prominent heading) -->
                    <Label x:Name="TitleLabel"
                           SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookTitleDescription}"
                           Text="{Binding Book.Title}"
                           FontSize="24"
                           FontAttributes="Bold" />

                    <!-- Author with label -->
                    <Grid ColumnDefinitions="Auto, *" Padding="0,4,0,0">
                        <Label Grid.Column="0"
                               SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookAuthorDescription}"
                               Text="{x:Static local:AppResources.BookDetailPageAuthorLabel}"
                               FontSize="16"
                               VerticalOptions="Center"
                               Margin="0,0,8,0" />
                        <Label Grid.Column="1"
                               Text="{Binding Book.Author}"
                               FontSize="18"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- ISBN with label -->
                    <Grid ColumnDefinitions="Auto, *" Padding="0,4,0,0">
                        <Label Grid.Column="0"
                               SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageISBNDescription}"
                               Text="{x:Static local:AppResources.BookDetailPageISBNLabel}"
                               FontSize="14"
                               VerticalOptions="Center"
                               Margin="0,0,8,0"
                               Opacity="0.7" />
                        <Label Grid.Column="1"
                               Text="{Binding Book.ISBN}"
                               FontSize="16"
                               VerticalOptions="Center"
                               Opacity="0.7" />
                    </Grid>

                    <!-- Publisher with label -->
                    <Grid ColumnDefinitions="Auto, *" Padding="0,4,0,0">
                        <Label Grid.Column="0"
                               SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookPublisherDescription}"
                               Text="{x:Static local:AppResources.BookDetailPagePublisherLabel}"
                               FontSize="14"
                               VerticalOptions="Center"
                               Margin="0,0,8,0" />
                        <Label Grid.Column="1"
                               Text="{Binding Book.Publisher}"
                               FontSize="16"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Publish Date with label -->
                    <Grid ColumnDefinitions="Auto, *"
                          Padding="0,4,0,0"
                          IsVisible="{Binding Book.PublishDate, Converter={toolkit:IsStringNotNullOrWhiteSpaceConverter}}">
                        <Label Grid.Column="0"
                               SemanticProperties.Description="{x:Static local:AppResources.BookDetailPagePublicationDateDescription}"
                               Text="{x:Static local:AppResources.BookDetailPagePublishDateLabel}"
                               FontSize="14"
                               VerticalOptions="Center"
                               Margin="0,0,8,0" />
                        <Label Grid.Column="1" Text="{Binding Book.PublishDate, StringFormat='{0:yyyy-MM-dd}'}"
                               FontSize="16"
                               VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>

                <HorizontalStackLayout Margin="0,16,0,8">
                    <Label x:Name="BookmarksTitleLabel"
                           SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookmarksSectionDescription}"
                           Text="{x:Static local:AppResources.BookDetailPageBookmarksTitle}"
                           FontSize="20"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <CollectionView
                    SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookmarkListDescription}"
                    ItemsSource="{Binding Bookmarks}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:BookmarkEntity">
                            <Grid ColumnDefinitions="Auto, Auto, *, Auto" Padding="8"
                                  SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookmarkEntryDescription}">
                                <Label Grid.Column="0"
                                       Text="{Binding StartPage, StringFormat={x:Static local:AppResources.BookDetailPageBookmarkPageLabel}}"
                                       FontSize="16"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="{Binding EndPage, StringFormat={x:Static local:AppResources.BookDetailPageBookmarkRangeLabel}}"
                                       VerticalOptions="Center"
                                       FontSize="16"
                                       IsVisible="{Binding EndPage, Converter={toolkit:IsNotNullConverter}}" />

                                <HorizontalStackLayout Grid.Column="3" Spacing="8" VerticalOptions="Center">
                                    <!-- Note icon only - no edit/delete buttons -->
                                    <ImageButton
                                        SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageViewNoteDescription}"
                                        Source="note_icon.svg"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        MaximumHeightRequest="32"
                                        MaximumWidthRequest="32"
                                        Margin="8,0,0,0"
                                        IsVisible="{Binding Note, Converter={toolkit:IsNotNullConverter}}"
                                        Command="{Binding ShowNoteCommand, Source={x:RelativeSource AncestorType={x:Type viewModels:TrashBookDetailViewModel}}, x:DataType={x:Type viewModels:TrashBookDetailViewModel}}"
                                        CommandParameter="{Binding Note}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</pages:ShelflyContentPageBase>
