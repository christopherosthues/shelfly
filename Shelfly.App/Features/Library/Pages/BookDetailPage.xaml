<?xml version="1.0" encoding="utf-8" ?>
<pages:ShelflyContentPageBase
    x:Class="Shelfly.App.Features.Library.Pages.BookDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="using:Shelfly.App.Resources.Localization"
    xmlns:viewModels="clr-namespace:Shelfly.App.Features.Library.ViewModels"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:pages="clr-namespace:Shelfly.App.Pages"
    xmlns:entities="clr-namespace:Shelfly.App.Data.Entities;assembly=Shelfly.App.Data"
    x:DataType="viewModels:BookDetailViewModel"
    Title="{x:Static local:AppResources.BookDetailPageTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageSoftDeleteBookDescription}"
                     Text="{x:Static local:AppResources.BookDetailPageDeleteBookButtonText}"
                     Command="{Binding DeleteBookCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               HeightRequest="40"
                               WidthRequest="40" />

            <VerticalStackLayout IsVisible="{Binding Book, Converter={toolkit:IsNotNullConverter}}" Spacing="8">
                <Label x:Name="TitleLabel" SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookTitleDescription}" Text="{Binding Book.Title}" FontSize="24" FontAttributes="Bold" />
                <Label x:Name="AuthorLabel" SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookAuthorDescription}" Text="{Binding Book.Author}" FontSize="16" />
                <Label x:Name="ISBNLabel" SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageISBNDescription}" Text="{Binding Book.ISBN}" FontSize="14" Opacity="0.7" />
                <Label x:Name="PublisherLabel" SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookPublisherDescription}" Text="{Binding Book.Publisher}" FontSize="14" />
                <Label x:Name="PublishDateLabel" SemanticProperties.Description="{x:Static local:AppResources.BookDetailPagePublicationDateDescription}" Text="{Binding Book.PublishDate, StringFormat='{0:yyyy-MM-dd}'}" FontSize="14" IsVisible="{Binding Book.PublishDate}" />
            </VerticalStackLayout>

            <Label x:Name="BookmarksTitleLabel" SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookmarksSectionDescription}" Text="{x:Static local:AppResources.BookDetailPageBookmarksTitle}"
                    FontSize="20"
                    FontAttributes="Bold"
                    Margin="0,16,0,8" />

            <CollectionView SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookmarkListDescription}" ItemsSource="{Binding Bookmarks}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:BookmarkEntity">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItem Text="{x:Static local:AppResources.BookDetailPageDeleteBookmarkCommand}"
                                           BackgroundColor="Red"
                                           IconImageSource="delete_icon.svg"
                                           Command="{Binding DeleteBookmarkCommand, Source={x:RelativeSource AncestorType={x:Type viewModels:BookDetailViewModel}}, x:DataType={x:Type viewModels:BookDetailViewModel}}"
                                           CommandParameter="{Binding}" />
                            </SwipeView.RightItems>

                            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto" Padding="8"
                                   SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookmarkEntryDescription}">
                                <Label Grid.Column="0"
                                        Text="{Binding StartPage, StringFormat={x:Static local:AppResources.BookDetailPageBookmarkPageLabel}}"
                                        VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                        Text="{Binding EndPage, StringFormat={x:Static local:AppResources.BookDetailPageBookmarkRangeLabel}}"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding EndPage}" />

                                <ImageButton Grid.Column="2"
                                               SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageViewNoteDescription}"
                                               Source="note_icon.svg"
                                               WidthRequest="24"
                                               HeightRequest="24"
                                               Margin="8,0,8,0"
                                               IsVisible="{Binding Note, Converter={toolkit:IsNotNullConverter}}"
                                               Command="{Binding ShowNoteCommand, Source={x:RelativeSource AncestorType={x:Type viewModels:BookDetailViewModel}}, x:DataType={x:Type viewModels:BookDetailViewModel}}"
                                               CommandParameter="{Binding Note}" />

                                <ImageButton Grid.Column="3"
                                               SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageEditBookmarkDescription}"
                                               Source="edit_icon.svg"
                                               WidthRequest="24"
                                               HeightRequest="24"
                                               Margin="8,0,0,0"
                                               Command="{Binding EditBookmarkCommand, Source={x:RelativeSource AncestorType={x:Type viewModels:BookDetailViewModel}}, x:DataType={x:Type viewModels:BookDetailViewModel}}"
                                               CommandParameter="{Binding}" />
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageAddNewBookmarkDescription}"
                    Text="{x:Static local:AppResources.BookDetailPageAddBookmarkButtonText}"
                    Command="{Binding AddBookmarkCommand}"
                    Margin="0,16,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</pages:ShelflyContentPageBase>
