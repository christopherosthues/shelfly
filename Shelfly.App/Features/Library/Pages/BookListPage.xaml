<?xml version="1.0" encoding="utf-8" ?>
<pages:ShelflyContentPageBase
    x:Class="Shelfly.App.Features.Library.Pages.BookListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Shelfly.App.Features.Library.ViewModels"
    xmlns:resx="clr-namespace:Shelfly.App.Resources.Localization"
    xmlns:pages="clr-namespace:Shelfly.App.Pages"
    xmlns:controls="clr-namespace:Shelfly.App.Controls"
    xmlns:entities="clr-namespace:Shelfly.App.Data.Entities;assembly=Shelfly.App.Data"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="local:BookListViewModel"
    Title="{x:Static resx:AppResources.BookListPageSortByTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            SemanticProperties.Description="{x:Static resx:AppResources.BookListPageAddNewBookDescription}"
            IconImageSource="add_icon.svg"
            Text="{x:Static resx:AppResources.BookListPageAddBookButtonText}"
            Command="{Binding NavigateToAddBookCommand}" />
        <ToolbarItem
            SemanticProperties.Description="{x:Static resx:AppResources.BookListPageExportLibraryDescription}"
            IconImageSource="export_icon.svg"
            Text="{x:Static resx:AppResources.BookListPageExportLibraryButtonText}"
            Command="{Binding ExportLibraryCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, *">
        <!-- Top Controls: Search Bar + Sort Picker -->
        <FlexLayout
            Grid.Row="0"
            Direction="Row"
            Wrap="Wrap"
            JustifyContent="Start"
            AlignItems="Center"
            Margin="8">

            <SearchBar
                FlexLayout.Order="1"
                SemanticProperties.Description="{x:Static resx:AppResources.BookListPageSearchPlaceholder}"
                Placeholder="{x:Static resx:AppResources.BookListPageSearchPlaceholder}"
                Text="{Binding SearchQuery, Mode=TwoWay}">
                <SearchBar.Behaviors>
                    <toolkit:EventToCommandBehavior
                        EventName="TextChanged"
                        Command="{Binding SearchCommand}" />
                </SearchBar.Behaviors>
            </SearchBar>

            <Picker
                x:Name="SortPicker"
                FlexLayout.Order="2"
                Margin="8, 0, 0, 0"
                SemanticProperties.Description="{x:Static resx:AppResources.BookListPageSortBooksByDescription}"
                Title="{x:Static resx:AppResources.BookListPageSortByTitle}"
                ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SortCriterion, Mode=TwoWay}">
                <Picker.Behaviors>
                    <toolkit:EventToCommandBehavior
                        EventName="SelectedIndexChanged"
                        Command="{Binding SortCommand}"
                        CommandParameter="{Binding SelectedItem, Source={x:Reference SortPicker}}"/>
                </Picker.Behaviors>
            </Picker>
        </FlexLayout>

        <!-- Book List -->
        <CollectionView
            Grid.Row="1"
            SemanticProperties.Description="{x:Static resx:AppResources.BookListPageBookListDescription}"
            ItemsSource="{Binding Books}">

            <CollectionView.EmptyView>
                <Label
                    HorizontalOptions="Center"
                    SemanticProperties.Description="{x:Static resx:AppResources.BookListPageNoBooksFoundDescription}"
                    Text="{x:Static resx:AppResources.BookListPageEmptyStateMessage}" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="entities:BookEntity">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItem
                                BackgroundColor="Red"
                                IconImageSource="delete_icon.svg"
                                Text="{x:Static resx:AppResources.BookListPageSwipeToDeleteCommand}"
                                Command="{Binding SoftDeleteCommand, Source={x:RelativeSource AncestorType={x:Type local:BookListViewModel}}, x:DataType={x:Type local:BookListViewModel}}"
                                CommandParameter="{Binding Id}" />
                        </SwipeView.RightItems>

                        <controls:BookCardView
                            SemanticProperties.Description="{x:Static resx:AppResources.BookListPageBookEntryDescription}">

                            <controls:BookCardView.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding NavigateToDetailBookCommand, Source={x:RelativeSource AncestorType={x:Type local:BookListViewModel}}, x:DataType={x:Type local:BookListViewModel}}"
                                    CommandParameter="{Binding Id}" />
                            </controls:BookCardView.GestureRecognizers>
                        </controls:BookCardView>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Loading Indicator -->
        <ActivityIndicator
            Grid.Row="1"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}" />
    </Grid>
</pages:ShelflyContentPageBase>
