<?xml version="1.0" encoding="utf-8" ?>
<pages:ShelflyContentPageBase
    x:Class="Shelfly.App.Features.Library.Pages.BookListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Shelfly.App.Features.Library.ViewModels"
    xmlns:resx="clr-namespace:Shelfly.App.Resources.Localization"
    xmlns:pages="clr-namespace:Shelfly.App.Pages"
    xmlns:controls="clr-namespace:Shelfly.App.Controls"
    xmlns:entities="clr-namespace:Shelfly.App.Data.Entities;assembly=Shelfly.App.Data"
    xmlns:converters="clr-namespace:Shelfly.App.Converters"
    x:DataType="local:BookListViewModel"
    Title="{x:Static resx:AppResources.BookListPageTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            SemanticProperties.Description="{x:Static resx:AppResources.BookListPageExportLibraryDescription}"
            IconImageSource="export_icon.svg"
            Text="{x:Static resx:AppResources.BookListPageExportLibraryButtonText}"
            Command="{Binding ExportLibraryCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, *" ColumnDefinitions="*">
        <!-- Top Controls: Search + Sort -->
        <controls:SortFilterView
            Grid.Row="0"
            SearchText="{Binding SearchQuery, Mode=TwoWay}"
            SearchPlaceholder="{x:Static resx:AppResources.BookListPageSearchPlaceholder}"
            SearchDescription="{x:Static resx:AppResources.BookListPageSearchPlaceholder}"
            SearchCommand="{Binding SearchCommand}"
            ItemsSource="{Binding SortOptions}"
            SelectedIndex="{Binding SelectedSortOptionIndex, Mode=TwoWay}"
            SortIconSource="{Binding SortIconSource}"
            SortDirectionDescription="{Binding SortDirectionDescription}"
            SortDescription="{x:Static resx:AppResources.BookListPageSortBooksByDescription}"
            Title="{x:Static resx:AppResources.BookListPageSortByTitle}"
            ToggleCommand="{Binding ToggleSortDirectionCommand}"
            SortCommand="{Binding SortCommand}" />

        <!-- Book List -->
        <CollectionView
            Grid.Row="1"
            SemanticProperties.Description="{x:Static resx:AppResources.BookListPageBookListDescription}"
            ItemsSource="{Binding Books}">

            <CollectionView.EmptyView>
                <Label
                    HorizontalOptions="Center"
                    SemanticProperties.Description="{x:Static resx:AppResources.BookListPageNoBooksFoundDescription}"
                    Text="{Binding EmptyStateMessage}" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="entities:BookEntity">
                    <SwipeView>
                        <SwipeView.LeftItems>
                            <SwipeItem
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                                IconImageSource="edit_icon.svg"
                                Text="{x:Static resx:AppResources.BookListPageSwipeToEditCommand}"
                                Command="{Binding NavigateToEditBookCommand, Source={x:RelativeSource AncestorType={x:Type local:BookListViewModel}}, x:DataType={x:Type local:BookListViewModel}}"
                                CommandParameter="{Binding Id}" />
                        </SwipeView.LeftItems>

                        <SwipeView.RightItems>
                            <SwipeItem
                                BackgroundColor="Red"
                                IconImageSource="delete_icon.svg"
                                Text="{x:Static resx:AppResources.BookListPageSwipeToDeleteCommand}"
                                Command="{Binding SoftDeleteCommand, Source={x:RelativeSource AncestorType={x:Type local:BookListViewModel}}, x:DataType={x:Type local:BookListViewModel}}"
                                CommandParameter="{Binding Id}" />
                        </SwipeView.RightItems>

                        <controls:BookCardView
                            SemanticProperties.Description="{x:Static resx:AppResources.BookListPageBookEntryDescription}"
                            IsSelected="{Binding Id, Converter={converters:ContainsConverter}, ConverterParameter={Binding SelectedItemIds, Source={x:RelativeSource AncestorType={x:Type local:BookListViewModel}}, x:DataType={x:Type local:BookListViewModel}}}"
                            LongPressCommand="{Binding EnterSelectionModeCommand, Source={x:RelativeSource AncestorType={x:Type local:BookListViewModel}}, x:DataType={x:Type local:BookListViewModel}}"
                            TapCommand="{Binding NavigateToDetailBookCommand, Source={x:RelativeSource AncestorType={x:Type local:BookListViewModel}}, x:DataType={x:Type local:BookListViewModel}}"
                            TapCommandParameter="{Binding Id}" />

                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Loading Indicator -->
        <ActivityIndicator
            Grid.Row="1"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}" />

        <!-- Floating Action Button (FAB) -->
        <controls:FloatingActionButton
            Grid.Row="1"
            IconSource="add_icon.svg"
            Description="{x:Static resx:AppResources.BookListPageAddNewBookDescription}"
            Command="{Binding NavigateToAddBookCommand}" />
    </Grid>
</pages:ShelflyContentPageBase>
