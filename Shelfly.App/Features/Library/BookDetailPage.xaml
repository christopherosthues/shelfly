<?xml version="1.0" encoding="utf-8"?>

<pages:ShelflyContentPageBase
    x:Class="Shelfly.App.Features.Library.BookDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="using:Shelfly.App.Resources.Localization"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:pages="clr-namespace:Shelfly.App.Pages"
    xmlns:controls="clr-namespace:Shelfly.App.Controls"
    xmlns:converters="clr-namespace:Shelfly.App.Converters"
    xmlns:entities="clr-namespace:Shelfly.App.Data.Entities;assembly=Shelfly.App.Data"
    xmlns:library="clr-namespace:Shelfly.App.Features.Library"
    x:DataType="library:BookDetailViewModel"
    Title="{x:Static local:AppResources.BookDetailPageTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageSoftDeleteBookDescription}"
            Text="{x:Static local:AppResources.BookDetailPageDeleteBookButtonText}"
            IconImageSource="delete_icon.svg"
            Command="{Binding DeleteBookCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*" ColumnDefinitions="*">
        <!-- Book Details -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16" Padding="16">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HeightRequest="40"
                                   WidthRequest="40" />

                <VerticalStackLayout IsVisible="{Binding Book, Converter={toolkit:IsNotNullConverter}}"
                                     Spacing="8">
                    <!-- Title (prominent heading) -->
                    <Label x:Name="TitleLabel"
                           SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookTitleDescription}"
                           Text="{Binding Book.Title}"
                           FontSize="24"
                           FontAttributes="Bold" />

                    <!-- Author with label -->
                    <Grid ColumnDefinitions="Auto, *" Padding="0,4,0,0">
                        <Label Grid.Column="0"
                               SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookAuthorDescription}"
                               Text="{x:Static local:AppResources.BookDetailPageAuthorLabel}"
                               FontSize="16"
                               VerticalOptions="Center"
                               Margin="0,0,8,0" />
                        <Label Grid.Column="1"
                               Text="{Binding Book.Author}"
                               FontSize="18"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- ISBN with label -->
                    <Grid ColumnDefinitions="Auto, *" Padding="0,4,0,0">
                        <Label Grid.Column="0"
                               SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageISBNDescription}"
                               Text="{x:Static local:AppResources.BookDetailPageISBNLabel}"
                               FontSize="14"
                               VerticalOptions="Center"
                               Margin="0,0,8,0"
                               Opacity="0.7" />
                        <Label Grid.Column="1"
                               Text="{Binding Book.ISBN}"
                               FontSize="16"
                               VerticalOptions="Center"
                               Opacity="0.7" />
                    </Grid>

                    <!-- Publisher with label -->
                    <Grid ColumnDefinitions="Auto, *" Padding="0,4,0,0">
                        <Label Grid.Column="0"
                               SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookPublisherDescription}"
                               Text="{x:Static local:AppResources.BookDetailPagePublisherLabel}"
                               FontSize="14"
                               VerticalOptions="Center"
                               Margin="0,0,8,0" />
                        <Label Grid.Column="1"
                               Text="{Binding Book.Publisher}"
                               FontSize="16"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Publish Date with label -->
                    <Grid ColumnDefinitions="Auto, *"
                          Padding="0,4,0,0"
                          IsVisible="{Binding Book.PublishDate, Converter={toolkit:IsNotNullConverter}}">
                        <Label Grid.Column="0"
                               SemanticProperties.Description="{x:Static local:AppResources.BookDetailPagePublicationDateDescription}"
                               Text="{x:Static local:AppResources.BookDetailPagePublishDateLabel}"
                               FontSize="14"
                               VerticalOptions="Center"
                               Margin="0,0,8,0" />
                        <Label Grid.Column="1"
                               Text="{Binding Book.PublishDate, Converter={converters:DateOnlyConverter}}"
                               FontSize="16"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- CreatedAt date -->
                    <Grid ColumnDefinitions="Auto, *" Padding="0,4,0,0">
                        <Label Grid.Column="0"
                               SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageCreatedDateDescription}"
                               Text="{x:Static local:AppResources.BookDetailPageCreatedLabel}"
                               FontSize="14"
                               VerticalOptions="Center"
                               Margin="0,0,8,0"
                               Opacity="0.7" />
                        <Label Grid.Column="1"
                               Text="{Binding Book.CreatedAt, Converter={converters:DateTimeConverter}}"
                               FontSize="16"
                               VerticalOptions="Center"
                               Opacity="0.7" />
                    </Grid>

                    <!-- LastModifiedAt date -->
                    <Grid ColumnDefinitions="Auto, *"
                          Padding="0,4,0,0"
                          IsVisible="{Binding Book.LastModifiedAt, Converter={toolkit:IsNotNullConverter}}">
                        <Label Grid.Column="0"
                               SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageLastModifiedDateDescription}"
                               Text="{x:Static local:AppResources.BookDetailPageLastModifiedLabel}"
                               FontSize="14"
                               VerticalOptions="Center"
                               Margin="0,0,8,0"
                               Opacity="0.7" />
                        <Label Grid.Column="1"
                               Text="{Binding Book.LastModifiedAt, Converter={converters:DateTimeNullableConverter}}"
                               FontSize="16"
                               VerticalOptions="Center"
                               Opacity="0.7" />
                    </Grid>
                </VerticalStackLayout>

                <HorizontalStackLayout Margin="0,16,0,8">
                    <Label x:Name="BookmarksTitleLabel"
                           SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookmarksSectionDescription}"
                           Text="{x:Static local:AppResources.BookDetailPageBookmarksTitle}"
                           FontSize="20"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           Margin="0,0,16,0" />

                    <ImageButton
                        SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageAddNewBookmarkDescription}"
                        Source="add_icon.svg"
                        Command="{Binding AddBookmarkCommand}"
                        VerticalOptions="Center"
                        Margin="0,0,0,0" />
                </HorizontalStackLayout>

                <!-- <VerticalStackLayout -->
                <!--     BindableLayout.ItemsSource="{Binding Bookmarks}" -->
                <!--     BindableLayout.ItemTemplate=""> -->
                <!-- </VerticalStackLayout> -->
                <CollectionView
                    SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookmarkListDescription}"
                    ItemsSource="{Binding Bookmarks}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:BookmarkEntity">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="Auto, Auto, *, Auto" Padding="8"
                                      SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageBookmarkEntryDescription}">
                                    <Label Grid.Column="0"
                                           Text="{Binding StartPage, StringFormat={x:Static local:AppResources.BookDetailPageBookmarkPageLabel}}"
                                           FontSize="16"
                                           VerticalOptions="Center" />

                                    <Label Grid.Column="1"
                                           Text="{Binding EndPage, StringFormat={x:Static local:AppResources.BookDetailPageBookmarkRangeLabel}}"
                                           VerticalOptions="Center"
                                           FontSize="16"
                                           IsVisible="{Binding EndPage, Converter={toolkit:IsNotNullConverter}}" />

                                    <HorizontalStackLayout Grid.Column="3" Spacing="8" VerticalOptions="Center">
                                        <ImageButton
                                            SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageViewNoteDescription}"
                                            Source="note_icon.svg"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            MaximumHeightRequest="32"
                                            MaximumWidthRequest="32"
                                            Margin="8,0,0,0"
                                            IsVisible="{Binding Note, Converter={toolkit:IsNotNullConverter}}"
                                            Command="{Binding ShowNoteCommand, Source={x:RelativeSource AncestorType={x:Type library:BookDetailViewModel}}, x:DataType={x:Type library:BookDetailViewModel}}"
                                            CommandParameter="{Binding Note}" />

                                        <ImageButton
                                            SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageEditBookmarkDescription}"
                                            Source="edit_icon.svg"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            MaximumHeightRequest="32"
                                            MaximumWidthRequest="32"
                                            Command="{Binding EditBookmarkCommand, Source={x:RelativeSource AncestorType={x:Type library:BookDetailViewModel}}, x:DataType={x:Type library:BookDetailViewModel}}"
                                            CommandParameter="{Binding}" />

                                        <ImageButton
                                            SemanticProperties.Description="{x:Static local:AppResources.BookDetailPageDeleteBookmarkCommand}"
                                            Source="delete_icon.svg"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            MaximumHeightRequest="32"
                                            MaximumWidthRequest="32"
                                            Command="{Binding DeleteBookmarkCommand, Source={x:RelativeSource AncestorType={x:Type library:BookDetailViewModel}}, x:DataType={x:Type library:BookDetailViewModel}}"
                                            CommandParameter="{Binding}" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <BoxView
                                    HeightRequest="1"
                                    Margin="0, 2"
                                    Color="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SecondaryDarkText}}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Floating Action Button (FAB) -->
        <controls:FloatingActionButton
            Grid.Row="0"
            IconSource="edit_icon.svg"
            Description="{x:Static local:AppResources.BookDetailPageEditFabDescription}"
            Command="{Binding EditBookCommand}" />
    </Grid>
</pages:ShelflyContentPageBase>