<?xml version="1.0" encoding="UTF-8"?>

<Shell
    x:Class="Shelfly.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:libraryPages="clr-namespace:Shelfly.App.Features.Library.Pages"
    xmlns:trashPages="clr-namespace:Shelfly.App.Features.Trash.Pages"
    xmlns:resx="clr-namespace:Shelfly.App.Resources.Localization"
    Title="Shelfly">

    <Shell.FlyoutHeaderTemplate>
        <DataTemplate>
            <Image Aspect="AspectFit"
                   Source="library_icon.svg"
                   HeightRequest="200" />
        </DataTemplate>
    </Shell.FlyoutHeaderTemplate>

    <FlyoutItem
        Title="{x:Static resx:AppResources.AppShellBooksTitle}"
        Icon="library_icon.svg">
        <ShellContent
            ContentTemplate="{DataTemplate libraryPages:BookListPage}" />
    </FlyoutItem>

    <FlyoutItem
        Title="{x:Static resx:AppResources.AppShellTrashTitle}"
        Icon="trash_icon.svg">
        <ShellContent
            ContentTemplate="{DataTemplate trashPages:TrashListPage}" />
    </FlyoutItem>

    <Shell.FlyoutFooterTemplate>
        <DataTemplate>
            <Label
                HorizontalOptions="Center"
                Text="Copyright 2026" />
        </DataTemplate>
    </Shell.FlyoutFooterTemplate>

</Shell>