<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Private.CoreLib"
             x:Class="Shelfly.App.Books.AddEditBookPage"
             Title="{Binding PageTitle}">

    <ScrollView>
        <Grid RowDefinitions="*, Auto">
            <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="15">
                <Entry Placeholder="Title"
                       Text="{Binding Title}" />
                <Label Text="{Binding ValidationError_Title}"
                       TextColor="Red"
                       FontSize="Small" />

                <Entry Placeholder="Author"
                       Text="{Binding Author}" />

                <Entry Placeholder="ISBN"
                       Text="{Binding ISBN}" />
                <Label Text="{Binding ValidationError_ISBN}"
                       TextColor="Red"
                       FontSize="Small" />

                <DatePicker Date="{Binding PublishDate}"
                            MinimumDate="{x:Static sys:DateTime.MinValue}"
                            MaximumDate="{x:Static sys:DateTime.Today}" />
                <Label Text="{Binding ValidationError_PublishDate}"
                       TextColor="Red"
                       FontSize="Small" />

                <Button Text="{Binding SubmitButtonText}"
                        Command="{Binding SubmitCommand}"
                        HorizontalOptions="Fill" />
            </VerticalStackLayout>

            <ActivityIndicator Grid.Row="1"
                               IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="0,20,0,0" />
        </Grid>
    </ScrollView>

</ContentPage>
