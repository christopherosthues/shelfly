<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Shelfly.App.Books.BookDetailPage"
             x:Name="DetailPage"
             Title="Book Details">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <!-- Book Info Section -->
            <HorizontalStackLayout Spacing="10">
                <Button Text="Edit"
                        Command="{Binding EditBookCommand}"
                        WidthRequest="80" />
                <Button Text="Delete"
                        Command="{Binding DeleteBookCommand}"
                        Background="#E74C3C"
                        WidthRequest="80" />
            </HorizontalStackLayout>

            <Label Text="{Binding Book.Title}"
                   Style="{StaticResource Headline}" />
            <Label Text="{Binding Book.Author}"
                   Style="{StaticResource SubHeadline}" />
            <Label Text="{Binding Book.ISBN}"
                   FontSize="Small"
                   Opacity="0.6" />

            <!-- Bookmarks Section -->
            <Label Text="Bookmarks"
                   Style="{StaticResource Headline}"
                   Margin="0,20,0,10" />

            <CollectionView ItemsSource="{Binding Bookmarks}">
                <CollectionView.EmptyView>
                    <Label Text="No bookmarks saved"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontSize="Small"
                           Opacity="0.5" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <HorizontalStackLayout Padding="5" Spacing="10">
                                <VerticalStackLayout HorizontalOptions="FillAndExpand" Spacing="3">
                                    <Label Text="{Binding PageRange}" />
                                    <Label Text="{Binding Note}"
                                           FontSize="Small"
                                           Opacity="0.6" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Spacing="5">
                                    <Button Text="Edit"
                                            Command="{Binding Source={x:Reference DetailPage}, Path=BindingContext.EditBookmarkCommand}"
                                            CommandParameter="{Binding}"
                                            WidthRequest="50" />
                                    <Button Text="Delete"
                                            Command="{Binding Source={x:Reference DetailPage}, Path=BindingContext.DeleteBookmarkCommand}"
                                            CommandParameter="{Binding}"
                                            Background="#E74C3C"
                                            WidthRequest="50" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                        </ViewCell>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center" />

            <!-- Add Bookmark Form -->
            <Frame Margin="0,20,0,0">
                <VerticalStackLayout Padding="10" Spacing="10">
                    <Label Text="Add Bookmark"
                           Style="{StaticResource SubHeadline}" />
                    <Entry Placeholder="Start Page"
                           Text="{Binding NewBookmarkStartPage}" />
                    <Entry Placeholder="End Page"
                           Text="{Binding NewBookmarkEndPage}" />
                    <Editor Placeholder="Note"
                            Text="{Binding NewBookmarkNote}"
                            HeightRequest="60" />
                    <Button Text="Add Bookmark"
                            Command="{Binding AddBookmarkCommand}"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
