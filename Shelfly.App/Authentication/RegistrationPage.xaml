<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:authentication="clr-namespace:Shelfly.App.Authentication"
             xmlns:localization="clr-namespace:Shelfly.App.Resources.Localization"
             x:Class="Shelfly.App.Authentication.RegistrationPage"
             x:DataType="authentication:RegistrationViewModel"
             Title="{x:Static localization:AppResources.RegistrationPageTitle}">
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout>
                <Entry Text="{Binding UserName}"
                       Placeholder="{x:Static localization:AppResources.RegistrationPageUserNamePlaceholder}" />
                <Entry Text="{Binding Password}"
                       Placeholder="{x:Static localization:AppResources.RegistrationPagePasswordPlaceholder}"
                       IsPassword="True" />
                <Button Text="{x:Static localization:AppResources.RegistrationPageRegisterButtonText}"
                        IsEnabled="{Binding CanRegister}"
                        Command="{Binding RegisterCommand}" />
                <Button Text="{x:Static localization:AppResources.RegistrationPageLoginButtonText}"
                        Command="{Binding GoToLoginCommand}" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>