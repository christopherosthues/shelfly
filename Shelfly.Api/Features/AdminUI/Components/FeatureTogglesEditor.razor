@namespace Shelfly.Api.Features.AdminUI.Components
@inject Microsoft.Extensions.Options.IOptionsMonitor<ServerDynamicConfiguration> OptionsMonitor

<div class="form-check mb-2">
    <input type="checkbox" class="form-check-input" @bind="@Config.MaintenanceModeEnabled" />
    <label class="form-check-label">Maintenance Mode Enabled</label>
</div>

<div class="form-check mb-2">
    <input type="checkbox" class="form-check-input" @bind="@Config.RegistrationEnabled" />
    <label class="form-check-label">Registration Enabled</label>
</div>

<div class="form-check mb-2">
    <input type="checkbox" class="form-check-input" @bind="@Config.RemoteSyncEnabled" />
    <label class="form-check-label">Remote Sync Enabled</label>
</div>

<button type="button" class="btn btn-primary mt-3" @onclick="OnSave">Save</button>
@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-success mt-2">@Message</div>
}

@code {
    [Parameter]
    public FeatureToggles Config { get; set; } = new();

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private string? Message;

    private async Task OnSave()
    {
        ServerDynamicConfiguration current = OptionsMonitor.CurrentValue;
        current.Features.MaintenanceModeEnabled = Config.MaintenanceModeEnabled;
        current.Features.RegistrationEnabled = Config.RegistrationEnabled;
        current.Features.RemoteSyncEnabled = Config.RemoteSyncEnabled;
        await OnSaved.InvokeAsync();
        Message = "Feature toggles saved.";
    }
}
