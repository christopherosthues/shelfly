@namespace Shelfly.Api.Features.AdminUI.Components
@inject Microsoft.Extensions.Options.IOptionsMonitor<ServerDynamicConfiguration> OptionsMonitor

<div class="mb-3">
    <label class="form-label">Base URL</label>
    <input type="text" class="form-control" @bind="@Config.BaseUrl" />
</div>

<div class="mb-3">
    <label class="form-label">Realm</label>
    <input type="text" class="form-control" @bind="@Config.Realm" />
</div>

<div class="mb-3">
    <label class="form-label">Issuer (Optional)</label>
    <input type="text" class="form-control" @bind="@Config.Issuer" />
    <div class="form-text">JWT issuer URL. Falls back to BaseUrl if null.</div>
</div>

<div class="mb-3">
    <label class="form-label">Admin Password Secret Key</label>
    <input type="text" class="form-control" @bind="@Config.AdminPasswordSecretKey" />
    <div class="form-text">Key name used to retrieve the admin password from secrets store.</div>
</div>

<button type="button" class="btn btn-primary mt-3" @onclick="OnSave">Save</button>
@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-success mt-2">@Message</div>
}

@code {
    [Parameter]
    public KeycloakConfig Config { get; set; } = new();

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private string? Message;

    private async Task OnSave()
    {
        ServerDynamicConfiguration current = OptionsMonitor.CurrentValue;
        current.Keycloak.BaseUrl = Config.BaseUrl;
        current.Keycloak.Realm = Config.Realm;
        current.Keycloak.Issuer = Config.Issuer;
        current.Keycloak.AdminPasswordSecretKey = Config.AdminPasswordSecretKey;
        await OnSaved.InvokeAsync();
        Message = "Keycloak configuration saved.";
    }
}
