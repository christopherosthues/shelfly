@namespace Shelfly.Api.Features.AdminUI.Components
@inject Microsoft.Extensions.Options.IOptionsMonitor<ServerDynamicConfiguration> OptionsMonitor

<div class="mb-3">
    <label class="form-label">Grace Period (Days)</label>
    <input type="number" class="form-control" min="1" max="365"
           @bind="@Config.GracePeriodDays" />
    <div class="form-text">Number of days before soft-deleted records are permanently removed.</div>
</div>

<button type="button" class="btn btn-primary" @onclick="OnSave">Save</button>
@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-success mt-2">@Message</div>
}

@code {
    [Parameter]
    public DeletionConfig Config { get; set; } = new();

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private string? Message;

    private async Task OnSave()
    {
        ServerDynamicConfiguration current = OptionsMonitor.CurrentValue;
        current.Deletion.GracePeriodDays = Config.GracePeriodDays;
        await OnSaved.InvokeAsync();
        Message = "Deletion configuration saved.";
    }
}
