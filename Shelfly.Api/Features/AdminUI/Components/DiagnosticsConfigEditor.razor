@namespace Shelfly.Api.Features.AdminUI.Components
@inject Microsoft.Extensions.Options.IOptionsMonitor<ServerDynamicConfiguration> OptionsMonitor

<div class="mb-3">
    <label class="form-label">Telemetry Sampling Rate</label>
    <input type="number" class="form-control" min="0" max="1" step="0.1" 
           @bind="@Config.TelemetrySamplingRate" />
    <div class="form-text">Percentage of telemetry data to sample (0.0 - 1.0).</div>
</div>

<div class="form-check mb-2">
    <input type="checkbox" class="form-check-input" @bind="@Config.HealthChecksEnabled" />
    <label class="form-check-label">Health Checks Enabled</label>
</div>

<button type="button" class="btn btn-primary mt-3" @onclick="OnSave">Save</button>
@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-success mt-2">@Message</div>
}

@code {
    [Parameter]
    public DiagnosticsConfig Config { get; set; } = new();

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private string? Message;

    private async Task OnSave()
    {
        ServerDynamicConfiguration current = OptionsMonitor.CurrentValue;
        current.Diagnostics.TelemetrySamplingRate = Config.TelemetrySamplingRate;
        current.Diagnostics.HealthChecksEnabled = Config.HealthChecksEnabled;
        await OnSaved.InvokeAsync();
        Message = "Diagnostics configuration saved.";
    }
}
