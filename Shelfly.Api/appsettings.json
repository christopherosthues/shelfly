{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDB": {
    "Host": "${MONGODB_HOST}",
    "Port": "${MONGODB_PORT}",
    "Username": "${MONGODB_USERNAME}",
    "Database": "${MONGODB_DATABASE}",
    "AuthSource": "${MONGODB_AUTH_SOURCE}"
  }
}
